# Defaults read by run_gateway.sh (KEY=VALUE lines only; no shell syntax).
# Variables already set in the calling environment take precedence, so
#   KVRGW_BATCH_SIZE=1 ./run_gateway.sh start
# overrides the value below. Point at a different file with ENV_FILE=...

# Storage tiers (bytes). <= MAX_INLINE: inline in the metadata record;
# <= MAX_KV_STORE: separate FDB key; larger: file under DATA_DIR.
KVRGW_MAX_INLINE=256
KVRGW_MAX_KV_STORE=4096

# PUT batch coalescing (one FDB transaction per batch; size 1 disables, max 16).
KVRGW_BATCH_SIZE=10
KVRGW_BATCH_TIMEOUT_US=1000
KVRGW_BATCH_THREADS=8

# Perf driver only (run_gateway.sh perf; the gateway ignores these). Matches Perf-Test-Put-3:
# object name = <16-char prefix>/.../<8-char suffix>, 2 tags of 200 bytes per object.
KVRGW_PREFIX_LEN=16
KVRGW_SUFFIX_LEN=8
KVRGW_TAG_COUNT=2
KVRGW_TAG_NAME_BASE=mytag
KVRGW_TAG_DATA_SIZE=200

# Perf workload (run_gateway.sh perf-run / perf_multi.sh; same as Perf-Test-Put-3).
PERF_BUCKETS=4
PERF_MODE=versioned
PERF_C=128
PERF_TIERS=8192
PERF_DURATION=180
PERF_BURST=5
PERF_SIM_DISK_WRITE_US=0
PERF_SIM_DISK_READ_US=0
# yes: delete objects and buckets after the run
PERF_CLEANUP=no

# Uncomment to override. Run several gateways with distinct instance ids.
# KVRGW_BATCH_MAX_INFLIGHT=4
# KVRGW_KV_STORE_COALESCING=1
# KVRGW_INSTANCE_ID=0
# KVRGW_TENANT_NAME=kv-poc
# KVRGW_GOMAXPROCS=
# KVRGW_DEBUG=
# ROOT_ACCESS_KEY=test
# ROOT_SECRET_KEY=test
